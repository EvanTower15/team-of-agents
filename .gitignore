# Secrets — never commit API keys
.env

# Generated vector store
chroma_db/

# Generated chat history database (WAL mode adds the -wal/-shm sidecars)
data/chat_history.db
data/chat_history.db-wal
data/chat_history.db-shm
# Generated CLIP image-embedding index (rebuilt automatically from data/*/visuals/)
clip_index.npz

# Python
__pycache__/
*.pyc
.venv/
venv/
.venv*/
*.egg-info/

# OS / editor noise
.DS_Store
Thumbs.db

# VS Code multi-root workspace files. These are personal and machine-specific --
# they hardcode each developer's local folder layout (e.g. a sibling ../opim-5517
# checkout), so one person's file is wrong for everyone else. Keep your own
# locally; it stays put across branch switches because it is untracked.
*.code-workspace
