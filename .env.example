# Copy this file to .env and fill in your keys. NEVER commit .env.

# REQUIRED. Free key: https://console.groq.com
# Powers the router, all four specialist agents, and synthesis.
GROQ_API_KEY=

# OPTIONAL — only needed for the photo-upload feature (src/vision.py).
# Free key, no credit card: https://aistudio.google.com/apikey
# Groq has no vision-capable model available, so this single per-upload call
# goes to Google Gemini instead (see PROJECT_PLAN.md decision D18). Everything
# else stays on Groq. Text-only questions work fine with this left blank.
GOOGLE_API_KEY=

# Optional: LangSmith tracing (https://smith.langchain.com) to inspect/debug
# every LLM call the agents make. Leave blank to disable.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
